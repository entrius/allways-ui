PARTNERCODE_CLAUDE_WEEKLY_CALL_LIMIT=0
PARTNERCODE_CODEX_DAILY_CALL_LIMIT=0
PARTNERCODE_CLAUDE_DAILY_CALL_LIMIT=0
PARTNERCODE_CODEX_MODEL=gpt-5.4
PARTNERCODE_CODEX_REASONING=''
